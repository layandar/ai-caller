# ---- LLM (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- TTS (Kokoro, OpenAI-compatible /audio/speech endpoint) ----
# Local Kokoro-FastAPI:  docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest  -> http://localhost:8880/v1
# OpenRouter hosts it too: KOKORO_BASE_URL=https://openrouter.ai/api/v1  KOKORO_MODEL=hexgrad/kokoro-82m (KOKORO_API_KEY may stay empty, OPENROUTER_API_KEY is reused)
KOKORO_BASE_URL=https://openrouter.ai/api/v1
KOKORO_API_KEY=
KOKORO_MODEL=hexgrad/kokoro-82m
KOKORO_VOICE=af_heart

# ---- Telephony (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL of this server so Twilio can fetch TwiML + audio (ngrok http 8000)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

COMPANY_NAME=Acme Corp
# Set to 1 to never touch Twilio (UI + LLM + TTS only)
DRY_RUN=0

# ---- Database (Supabase, optional). Unset = data/employees.json + in-memory sessions ----
# Project URL + a publishable (sb_publishable_...) or, better for a server, secret (sb_secret_...) key
SUPABASE_URL=
SUPABASE_KEY=
